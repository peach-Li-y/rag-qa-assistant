# ============================================================
# 环境变量配置模板
# 使用方法：复制本文件为 .env，填入你自己的火山方舟 API Key 即可。
#   cp .env.example .env      # Linux / macOS
#   copy .env.example .env    # Windows
# 注意：.env 已被 .gitignore 忽略，不会上传到仓库，请勿泄露你的 Key。
# ============================================================

# 火山方舟标准 OpenAI 兼容接口（按量推理通道，不要改成 /api/coding/v3）
OPENAI_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# 模型 ID：必须与火山方舟控制台“在线推理 / 模型开通”中的名称完全一致
# （连字符 + 日期版本后缀），可在控制台更换为你已开通的其他模型
OPENAI_MODEL="doubao-seed-2-0-mini-260428"

# 火山方舟 API Key（在控制台 API Key 管理中创建，形如 ark-xxxxxxxx）
OPENAI_API_KEY="在此填入你的 API Key"
