# ===== Python 虚拟环境（不入库）=====
venv/
.venv/
env/

# ===== 本地密钥 / 环境变量（严禁入库，防止 API Key 泄露）=====
.env
!.env.example

# ===== 本地向量模型缓存（体积约数百 MB，不入库；首次运行自动下载）=====
model_cache/

# ===== 课件原文 PDF（如有版权限制不入库；目录用 .gitkeep 保留）=====
data/*.pdf

# ===== Python 缓存 =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# ===== Streamlit / Chroma 运行产物 =====
.streamlit/
.chroma/
chroma_db/

# ===== 日志与临时文件 =====
*.log
_probe_*
_verify_*
_*.txt

# ===== 操作系统 =====
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

